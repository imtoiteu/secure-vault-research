<mxfile host="secure-vault-report" modified="2026-08-20T00:00:00.000Z" agent="figlib" version="24.7.7" type="device">
  <diagram id="Hinh-3-06-chia-se-bi-mat" name="Hinh-3-06-chia-se-bi-mat">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.6 — Lược đồ chia sẻ bí mật lai: Shamir trên DEK + AEAD trên tải trọng" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1148" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Vì sao phải lai: nguyên thủy sss chỉ chia được đúng một khóa 32 byte" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1148" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Chia (split_secret / split_file)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#9CCBA9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1100" height="290" as="geometry"/></mxCell>
        <mxCell id="z1" value="Khôi phục (recover_secret) — năm cổng kiểm tra không bí mật rồi mới tới AEAD" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFAF2;strokeColor=#E3BC85;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="402" width="1100" height="300" as="geometry"/></mxCell>
        <mxCell id="c3" value="Bí mật tùy độ dài&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;chuỗi người dùng gõ, hoặc nội dung tệp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="136" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="c4" value="nameframe::frame&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;gắn tên tệp gốc VÀO BÊN TRONG vùng sẽ mã hóa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="208" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="c5" value="DEK 32 byte ngẫu nhiên&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;getrandom&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="136" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="c6" value="group_id 16 byte&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;thay cho UUID két&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="208" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="c7" value="derive_payload_key&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;BLAKE3(&quot;…/SVSS|group|n|k&quot;, DEK)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="172" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="c8" value="secretbox::seal&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;nonce 24 B + thẻ 16 B&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="172" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="c9" value="Tệp tải trọng SVSSP&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;MAGIC (6) ‖ ver (2) ‖ aead_alg (1) ‖ nonce (24) ‖ ciphertext&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="288" width="260" height="72" as="geometry"/></mxCell>
        <mxCell id="c10" value="payload_ref = BLAKE3(cả tệp tải trọng)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;ràng buộc từng mảnh với đúng tải trọng này&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="288" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="c11" value="n tệp mảnh SVSSS — mỗi tệp đúng 92 byte&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;MAGIC (6) ‖ ver (2) ‖ group_id (16) ‖ n (1) ‖ k (1) ‖ index (1) ‖ payload_ref (32) ‖ mảnh (33)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="288" width="480" height="72" as="geometry"/></mxCell>
        <mxCell id="c12" value="1. Đồng thuận: mọi mảnh phải cùng group_id, cùng n, k, cùng payload_ref" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="444" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c13" value="2. Trùng hoành độ: hai mảnh cùng x làm phép nội suy Lagrange suy biến ⇒ từ chối ngay" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="484" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c14" value="3. Hoành độ khác 0: mảnh thật không bao giờ dùng x = 0 (bí mật nằm tại x = 0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="524" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c15" value="4. Đếm số mảnh: got &amp;lt; k ⇒ SV-INSUFFICIENT-SHARES { got, need }" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="564" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c16" value="5. Ràng buộc tải trọng: BLAKE3(tệp tải trọng) phải khớp payload_ref trong mảnh" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="604" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c17" value="Cổng mật mã cuối cùng&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;combine → DEK → derive_payload_key(group_id, n, k) → secretbox::open. Mọi thất bại tại đây đều là SV-UNAUTHORIZED, không phân biệt sai mảnh hay bản mã bị sửa.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="c18" value="Mỗi mảnh còn được xuất thành chuỗi Base64 124 ký tự để chép tay, và có thể in thành ảnh QR PNG (mức sửa lỗi H)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="646" width="700" height="44" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c20" value="dữ liệu rõ đã đóng khung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c22" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c26" value="SssSharer::split(DEK, n, k)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#8A94A4;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c28" value="Vì secretbox không nhận dữ liệu liên kết (AAD), tính toàn vẹn của phần header không được bảo vệ bằng AAD mà bằng cách gấp bộ ba (group_id, n, k) vào chính chuỗi ngữ cảnh dẫn xuất khóa tải trọng. Sửa bất kỳ byte nào trong ba trường đó sẽ dẫn xuất ra khóa khác và thẻ Poly1305 lập tức hỏng — đây chính là thuộc tính chịu lực của lược đồ." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="725" width="1100" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: crates/sv-platform/src/sharing.rs split_core/recover_core/derive_payload_key, encode_share_string; crates/sv-qr/src/lib.rs" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="794" width="1148" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
