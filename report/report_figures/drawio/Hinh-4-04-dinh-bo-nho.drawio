        <mxCell id="c35" value="Lưu ý phương pháp: chỉ cột 1024 MiB là số đo. Bốn cột còn lại là ngoại suy tuyến tính từ hệ số đã đo và được ghi nhãn rõ ràng; chúng KHÔNG được coi là kết quả thực nghiệm." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="629" width="860" height="26.4" as="geometry"/></mxCell>
