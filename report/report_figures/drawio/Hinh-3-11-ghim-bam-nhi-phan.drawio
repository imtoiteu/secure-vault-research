<mxfile host="secure-vault-report" modified="2026-08-20T00:00:00.000Z" agent="figlib" version="24.7.7" type="device">
  <diagram id="Hinh-3-11-ghim-bam-nhi-phan" name="Hinh-3-11-ghim-bam-nhi-phan">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.11 — Ghim băm nhị phân ngoài lúc biên dịch và phân giải lúc chạy" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1148" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Chuỗi kiểm soát chuỗi cung ứng: nạp → ghim → kiểm kiến trúc → phân giải → xác minh lại → chạy có rào" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1148" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Thời điểm biên dịch — desktop/build.rs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#9CCBA9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="1100" height="250" as="geometry"/></mxCell>
        <mxCell id="z1" value="Thời điểm chạy — desktop/src/lib.rs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#8FC8A3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="366" width="1100" height="250" as="geometry"/></mxCell>
        <mxCell id="c3" value="Nạp nhị phân vào binaries/&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;age · age-keygen · exiftool&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="140" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="c4" value="Tính BLAKE3 của từng tệp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="140" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="c5" value="Phát hằng số qua env!()&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;băm được nhúng vào mã máy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="622" y="140" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="c6" value="Kiểm kiến trúc tệp&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;đọc header ELF / Mach-O / PE, KHÔNG thực thi&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="896" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c7" value="Chính sách bắt buộc và tùy chọn&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;age và age-keygen là BẮT BUỘC: bản release thiếu chúng thì build hỏng ngay. exiftool là TÙY CHỌN: thiếu thì mô-đun Phân tích tự tắt theo hướng an toàn (mọi lệnh trả lỗi thay vì âm thầm bỏ qua).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="236" width="1052" height="80" as="geometry"/></mxCell>
        <mxCell id="c8" value="resolve_binary&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;bản release CHỈ tìm trong thư mục tài nguyên của gói hoặc cạnh tệp thực thi&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="414" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="c9" value="SV_AGE_BIN / SV_EXIFTOOL_BIN&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;chỉ có hiệu lực trong bản debug — bề mặt phân giải bị đóng lại khi phát hành&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="414" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="c10" value="new_pinned: băm lại rồi so sánh&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;lệch băm ⇒ từ chối khởi tạo bộ điều hợp, không có đường vòng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="746" y="414" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="c11" value="Chạy có rào chắn&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;env_clear() (Windows chỉ thêm lại SystemRoot, SystemDrive, TEMP, TMP cho trình nạp DLL và bộ sinh số ngẫu nhiên) · không qua shell · thư mục làm việc riêng cho ExifTool · ExifTool luôn nhận -config &quot;&quot; để tắt cơ chế cấu hình bằng mã Perl · hạn giờ tường 120 giây cho age và 60 giây cho ExifTool&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="512" width="1052" height="80" as="geometry"/></mxCell>
        <mxCell id="c12" value="Khoảng trống đã ghi nhận&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Kiểm tra băm diễn ra một lần khi khởi tạo bộ điều hợp; nếu tệp nhị phân bị thay thế giữa lần kiểm tra và lần thực thi (TOCTOU) thì hệ thống không phát hiện được. Ngoài ra gói phát hành hiện chưa được ký số và công chứng (H5), nên trên macOS một bản sao bị gắn nhãn cách ly có thể bị Gatekeeper chấm dứt — đây là điểm chặn phân phối đã được xác nhận bằng thực nghiệm.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="646" width="1100" height="76" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: desktop/build.rs (emit_pin, detect_staged_target, check_staged_arch); desktop/src/lib.rs resolve_binary/build_backend/build_meta; crates/sv-age/src/lib.rs new_pinned" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="754" width="1148" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
