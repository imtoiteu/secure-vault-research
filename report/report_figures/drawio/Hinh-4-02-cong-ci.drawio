        <mxCell id="c5" value="cargo clippy --workspace --all-targets -- -D warnings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=10;fontStyle=0;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="312" y="182" width="456" height="40" as="geometry"/></mxCell>
