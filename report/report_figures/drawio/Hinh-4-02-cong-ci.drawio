        <mxCell id="c9" value="msrv&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;cố định Rust 1.96 trên Ubuntu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="c10" value="desktop (ma trận 3 hệ điều hành)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;fmt · clippy -D · kiểm thử ui_contract&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="192" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="c11" value="supply-chain&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;cargo-deny + cargo-audit trên lõi và cây desktop&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="274" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="c12" value="sbom&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;sinh danh mục thành phần&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="356" width="280" height="66" as="geometry"/></mxCell>
        <mxCell id="c13" value="Kết quả đáng chú ý của lần chạy được ghi nhận&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Kiểm thử đầu-cuối age_backed_lifecycle_roundtrips chạy XANH trên máy windows-latest — đây là bằng chứng thực nghiệm đóng lại giả thuyết rủi ro H4 (lo ngại rằng env_clear() sẽ làm hỏng bộ sinh số ngẫu nhiên / trình nạp DLL của age trên Windows). Chênh lệch 127 so với 126 kiểm thử giữa Linux và Windows là do một hàm chỉ biên dịch trên Unix, không phải lỗi.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="1060" height="90" as="geometry"/></mxCell>
