        <mxCell id="c20" value="khai báo workspace, phiên bản phụ thuộc dùng chung, lint toàn cục" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="434" y="171.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c21" value="cố định phiên bản trình biên dịch và chính sách chuỗi cung ứng" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="434" y="215.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c22" value="791 dòng — DTO IPC/UI, ApiError 12 mã, nameframe" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="259.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c23" value="449 dòng — ABI: trait, kiểu giá trị bí mật, định danh thuật toán" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="303.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c24" value="214 dòng — FFI libsodium (sign, blake2b, secretbox)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="347.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c25" value="155 dòng + hazmat.c — FFI Shamir, randombytes nối vào getrandom" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="391.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c26" value="668 dòng — Blake3Hasher, Argon2Kdf, SssSharer, minisign, secretbox, policy" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="435.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c27" value="426 dòng — bộ điều hợp FileCipher trên tiến trình con age" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="479.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c28" value="1 316 dòng — format, container, keys, service, error của két .svault" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="523.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c29" value="1 945 dòng — artifact, crypto, integrity, sharing (không phụ thuộc két)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="567.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c30" value="≈2 490 dòng — carrier, embed, selector, envelope, seal, pipeline, detect" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="611.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c31" value="610 + 807 + 289 dòng — thủy vân, ExifTool, mã QR" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="655.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c32" value="1 990 dòng — gốc lắp ghép, 5 bề mặt lệnh, IpcPassphrase, VaultBackend" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="699.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c33" value="vỏ Tauri 2: build.rs (363 dòng), src/lib.rs (716 dòng), frontend tĩnh" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="743.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c34" value="18 tài liệu thiết kế + docs/architecture/ 10 chương kiến trúc" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="787.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c35" value="5 nhóm việc CI: check (3 hệ điều hành), msrv, desktop, supply-chain, sbom" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="831.4" width="690" height="25.439999999999998" as="geometry"/></mxCell>
        <mxCell id="c36" value="Quy ước phân tách quan trọng nhất: thư mục desktop/ được khai báo exclude trong workspace. Nhờ vậy cây phụ thuộc rất nặng của webview không đi vào cổng kiểm toán (cargo deny / cargo audit / cargo build --locked) của phần lõi mật mã, và phần lõi vẫn kiểm thử được trên máy không có bộ công cụ Tauri." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="881" width="1060" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: Cargo.toml (members, exclude), cây thư mục crates/, src-tauri/, desktop/, docs/" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="834" width="1128" height="18" as="geometry"/></mxCell>
