        <mxCell id="c18" value="Đơn vị chia sẻ duy nhất là một tệp mà người dùng tự di chuyển: két .svault, tệp .svenc, các mảnh Shamir hoặc ảnh mang dữ liệu ẩn. Hệ thống không có kênh truyền nào." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="629" width="1020" height="26.4" as="geometry"/></mxCell>
