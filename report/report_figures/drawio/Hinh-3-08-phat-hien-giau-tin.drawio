  <diagram id="Hinh-3-08-phat-hien-giau-tin" name="Hinh-3-08-phat-hien-giau-tin">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.8 — Bảng các bộ dò giấu tin và cơ chế hợp nhất mức nghi ngờ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1128" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Kết quả là mức NGHI NGỜ theo phương pháp thực nghiệm, không bao giờ là kết luận &quot;ảnh sạch&quot;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1128" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Bảng dò cho ảnh không mất mát (PNG / BMP)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFAF2;strokeColor=#E3BC85;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="z1" value="Bảng dò cho JPEG" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFAF2;strokeColor=#E3BC85;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="520" height="180" as="geometry"/></mxCell>
        <mxCell id="c3" value="Tệp ảnh đầu vào" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="c4" value="Phân nhánh theo vật chứa&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;FF D8 FF ⇒ JPEG, ngược lại ⇒ PNG/BMP&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="260" height="62" as="geometry"/></mxCell>
        <mxCell id="c5" value="AppendedDataDetector&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;dữ liệu nằm sau EOF hợp lệ + entropy Shannon + quét chữ ký tệp nhúng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="244" width="490" height="58" as="geometry"/></mxCell>
        <mxCell id="c6" value="ChiSquareDetector&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;kiểm định χ² trên cặp giá trị mẫu — dấu hiệu kinh điển của LSB tuần tự tỉ lệ cao&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="312" width="490" height="58" as="geometry"/></mxCell>
        <mxCell id="c7" value="RsDetector&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;phân tích Regular/Singular theo hàm lật, ước lượng tỉ lệ nhúng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="380" width="490" height="58" as="geometry"/></mxCell>
        <mxCell id="c8" value="jpeg_appended_signal&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;dữ liệu nằm sau dấu EOI&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="654" y="244" width="474" height="58" as="geometry"/></mxCell>
        <mxCell id="c9" value="jpeg_dct::analyze&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;χ² trên LSB của hệ số DCT đã lượng tử — miền nhúng thật của JPEG&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="654" y="312" width="474" height="58" as="geometry"/></mxCell>
        <mxCell id="c10" value="Hợp nhất: lấy điểm CAO NHẤT trong bảng&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;≥ 0,75 → High · ≥ 0,45 → Elevated · ≥ 0,20 → Low · còn lại → NotObserved&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="400" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="c11" value="StegoDetectReport&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;suspicion + danh sách StegoSignal (tên bộ dò, điểm 0…1, diễn giải) + câu cảnh báo cố định: &quot;suy đoán theo phương pháp thực nghiệm; nghi ngờ tăng không phải là bằng chứng, và không có tín hiệu cũng không phải là bằng chứng vắng mặt&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="512" width="560" height="92" as="geometry"/></mxCell>
        <mxCell id="c12" value="Mức thấp nhất là NotObserved&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;cố ý KHÔNG có mức &quot;Clean&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="220" height="92" as="geometry"/></mxCell>
