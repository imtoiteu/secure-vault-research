        <mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c22" value="Phạm vi trung thực do chính tài liệu của mô-đun ghi nhận: bảng dò này bắt tốt các trường hợp giấu tin thô sơ, tỉ lệ nhúng cao hoặc kiểu &quot;nối thêm tệp vào sau ảnh&quot;. Một tải trọng sv-stego đã mã hóa, hoán vị và tỉ lệ nhúng thấp thì gần như không bị các bộ dò này phát hiện — đó là sự thật, và cũng chính là lý do kết quả được trình bày dưới dạng mức nghi ngờ chứ không phải một phán quyết." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="639" width="1100" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: crates/sv-stego/src/detect/{mod,appended,chi_square,rs,jpeg_dct}.rs; sv_types::{StegoSignal, StegoDetectReport, Suspicion}" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="734" width="1128" height="18" as="geometry"/></mxCell>
