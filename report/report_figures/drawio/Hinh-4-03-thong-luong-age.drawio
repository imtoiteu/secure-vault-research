        <mxCell id="c12" value="Hệ quả về hạn giờ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Với thông lượng này, hạn giờ tường 120 giây chỉ bị chạm ở khoảng 44 GiB khi mã hóa và 35 GiB khi giải mã trên ổ đĩa cục bộ nhanh. Do đó hạn giờ là rủi ro ĐUÔI, không phải chế độ hỏng thường gặp.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="520" height="88" as="geometry"/></mxCell>
        <mxCell id="c13" value="Cảnh báo về phạm vi&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Chỉ một cấu hình, một lần đo, một kích thước tệp. Không đủ để rút ra đường cong thời gian theo kích thước.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="270" height="88" as="geometry"/></mxCell>
