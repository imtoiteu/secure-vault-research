  <diagram id="Hinh-3-05-ma-hoa-tep-doc-lap" name="Hinh-3-05-ma-hoa-tep-doc-lap">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.5 — Mã hóa và giải mã tệp độc lập bằng mật khẩu (định dạng SVENC)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1128" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Đường này KHÔNG dùng age: chỉ Argon2id + secretbox, thuần Rust + libsodium" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1128" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="Tệp đầu vào&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;≤ 2 GiB (kiểm bằng stat)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c4" value="Mật khẩu&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;IpcPassphrase → &amp;amp;[u8]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="196" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c5" value="Muối 16 byte mới&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;getrandom&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="282" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c6" value="Argon2id&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;tham số theo sàn OWASP&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="196" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c7" value="BLAKE3::derive_key&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;ngữ cảnh tách miền theo MAGIC&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="282" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c8" value="Khóa tệp FEK (32 byte)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Key32, tự xóa khi hủy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="c9" value="secretbox::seal (XSalsa20-Poly1305)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;nonce 24 byte ngẫu nhiên + thẻ Poly1305 16 byte&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="240" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c10" value="Tệp .svenc — 62 byte header + bản mã&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;MAGIC &quot;SVENC\0&quot; (6) ‖ version u16 (2) ‖ kdf_alg (1) ‖ mem_kib u32 ‖ time_cost u32 ‖ parallelism u32 ‖ salt (16) ‖ aead_alg (1) ‖ nonce (24) ‖ ciphertext&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="386" width="820" height="96" as="geometry"/></mxCell>
        <mxCell id="c11" value="Đường mở: đọc header, chặn tham số Argon2 vượt trần&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;mem ≤ 4 GiB, t ≤ 64, p ≤ 64 — kiểm TRƯỚC khi chạy KDF&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="512" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="c12" value="Mọi thất bại ⇒ SV-UNAUTHORIZED&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;sai mật khẩu và bản mã bị sửa không phân biệt được&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="512" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="c13" value="Tệp .svkey&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;cùng cơ chế, khác MAGIC — dùng để cất khóa ký Ed25519 khi lưu trữ&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="c14" value="dữ liệu rõ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
