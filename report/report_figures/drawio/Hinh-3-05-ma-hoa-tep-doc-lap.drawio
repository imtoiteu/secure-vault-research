        <mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c22" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c23" value="cùng cơ chế" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#8A94A4;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c24" value="Header là dữ liệu công khai nhưng CÓ THỂ bị kẻ tấn công điều khiển trước khi có bất kỳ phép xác thực nào, nên tham số chi phí Argon2 phải được chặn trần trước khi chạy KDF; nếu không, một tệp .svenc độc hại có thể yêu cầu hàng chục GiB bộ nhớ. Tính toàn vẹn của header không được bảo vệ bằng AAD (secretbox không có AAD) mà bằng cách gấp MAGIC vào ngữ cảnh dẫn xuất khóa: sửa header ⇒ sai khóa ⇒ hỏng thẻ xác thực." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="625" width="1080" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: crates/sv-platform/src/crypto.rs encrypt_file/decrypt_file; crates/sv-platform/src/artifact.rs seal_with_passphrase/open_with_passphrase" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="724" width="1128" height="18" as="geometry"/></mxCell>
