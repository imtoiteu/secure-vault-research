        <mxCell id="ttl" value="Hình 3.4 — Chia và khôi phục khóa chủ của két theo ngưỡng k trong n" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1148" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Phong bì mảnh SVSH 58 byte; mảnh không bao giờ được lưu trong két" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1148" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Đường chia (keys_split, cần phiên đã mở khóa)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#9CCBA9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="540" height="300" as="geometry"/></mxCell>
        <mxCell id="z1" value="Đường khôi phục (keys_recover, KHÔNG cần mật khẩu)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFAF2;strokeColor=#E3BC85;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="540" height="300" as="geometry"/></mxCell>
        <mxCell id="c3" value="Khóa chủ MK (32 byte)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;lấy từ bảng phiên&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="76" y="136" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="SssSharer::split(MK, n, k)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Shamir trên GF(2⁸), mảnh đã xác thực&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="136" width="236" height="60" as="geometry"/></mxCell>
        <mxCell id="c5" value="n mảnh, mỗi mảnh 33 byte (byte đầu là hoành độ x)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="76" y="216" width="490" height="56" as="geometry"/></mxCell>
        <mxCell id="c6" value="Phong bì SVSH — 58 byte cố định&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;MAGIC &quot;SVSH&quot; (4) ‖ version u16 LE (2) ‖ vault_uuid (16) ‖ index (1) ‖ total (1) ‖ threshold (1) ‖ mảnh (33)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="76" y="288" width="490" height="84" as="geometry"/></mxCell>
        <mxCell id="c7" value="Đọc k phong bì; kiểm MAGIC, phiên bản, độ dài" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="646" y="136" width="490" height="52" as="geometry"/></mxCell>
        <mxCell id="c8" value="Đối chiếu vault_uuid trong mảnh với uuid trong header két&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;lệch ⇒ SV-INVALID-INPUT &quot;mảnh thuộc két khác&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="646" y="200" width="490" height="52" as="geometry"/></mxCell>
        <mxCell id="c9" value="Kiểm số lượng: got &amp;lt; threshold ⇒ SV-INSUFFICIENT-SHARES { got, need }" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="646" y="264" width="490" height="46" as="geometry"/></mxCell>
        <mxCell id="c10" value="SssSharer::combine → MK ứng viên" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="646" y="322" width="490" height="50" as="geometry"/></mxCell>
        <mxCell id="c11" value="Cổng tín nhiệm chung: secretbox::open(wrapped_age_identity)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;thất bại ⇒ SV-UNAUTHORIZED — cùng một mã với trường hợp sai mật khẩu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="c12" value="Tạo phiên mới ↦ (MK, đường dẫn két)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;từ đây mọi thao tác giống hệt phiên mở bằng mật khẩu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="534" width="540" height="60" as="geometry"/></mxCell>
