        <mxCell id="c22" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c23" value="Hai thuộc tính đáng chú ý. Thứ nhất, ngưỡng là tính chất của lược đồ Shamir chứ không phải của phần mềm: với ít hơn k mảnh, thư viện vẫn trả về một khóa 32 byte nhưng là khóa SAI — bằng chứng là kiểm thử sss_below_threshold_yields_wrong_key. Thứ hai, vì thế phép kiểm tra thực sự nằm ở cổng mở bọc AEAD phía sau, chứ không nằm ở phép so sánh nào trên chính các mảnh." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="629" width="1100" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: src-tauri/src/service.rs split_key/recover, build_share_envelope/parse_share_envelope; crates/sv-crypto/src/lib.rs SssSharer" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="754" width="1148" height="18" as="geometry"/></mxCell>
