        <mxCell id="c26" value="không" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c27" value="Đây là thủy vân DỄ VỠ: bất kỳ thao tác biên tập nào — kể cả nén lại sang JPEG — đều làm hỏng dấu. Đó là ĐẶC TÍNH chứ không phải khuyết điểm: mục tiêu là phát hiện sửa đổi, không phải chứng minh bản quyền. Họ thủy vân bền vững (DWT-DCT-SVD) được ghi nhận là hướng nghiên cứu hoãn lại vì chưa có thư viện biến đổi sóng con hai chiều thuần Rust đủ tin cậy." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="709" width="1100" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguồn: crates/sv-watermark/src/lib.rs (BLOCK, PRESENCE_THRESHOLD, BLOCK_CONTEXT, PRESENCE_CONTEXT, WATERMARK_SALT)" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="774" width="1148" height="18" as="geometry"/></mxCell>
