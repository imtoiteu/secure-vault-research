  <diagram id="Hinh-3-09-thuy-van-de-vo" name="Hinh-3-09-thuy-van-de-vo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.9 — Thủy vân vô hình, có khóa, dễ vỡ: nhúng và kiểm tra" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1148" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Không phải giấu tin (không mang tải trọng) và cố ý KHÔNG bền vững — mục tiêu là bằng chứng sửa đổi" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1148" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Nhúng (watermark_embed) — chỉ ảnh PNG / BMP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#9CCBA9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="1100" height="250" as="geometry"/></mxCell>
        <mxCell id="z1" value="Kiểm tra (watermark_verify) — thang phán quyết ba mức" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFAF2;strokeColor=#E3BC85;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="456" width="1100" height="230" as="geometry"/></mxCell>
        <mxCell id="c3" value="Mật khẩu người dùng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="230" height="58" as="geometry"/></mxCell>
        <mxCell id="c4" value="Argon2id + muối cố định&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;muối chỉ để tách miền, không chống bảng cầu vồng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="230" height="58" as="geometry"/></mxCell>
        <mxCell id="c5" value="Khóa K (32 byte)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;không bao giờ được lưu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="c6" value="Chia ảnh thành khối 16 × 16&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;hàng/cột cuối hấp thụ phần dư nên mọi khối đều ≥ 16 px mỗi cạnh&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="234" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="c7" value="Nhãn từng khối&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;BLAKE3::keyed_hash(K, ngữ cảnh ‖ W ‖ H ‖ bx ‖ by ‖ nội dung)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="234" width="340" height="76" as="geometry"/></mxCell>
        <mxCell id="c8" value="&quot;Nội dung&quot; = 7 bit CAO của R, G, B&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;mặt bit thấp nhất bị loại khỏi phép băm nên nhúng không làm đổi nhãn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="234" width="336" height="76" as="geometry"/></mxCell>
        <mxCell id="c9" value="Rải 256 bit nhãn lên mặt LSB kênh LAM của khối&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;mọi LSB lam trong khối trở thành một bit nhãn ⇒ mọi sửa đổi nội dung đều làm hỏng nhãn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="330" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="c10" value="Dấu hiệu hiện diện trên mặt LSB kênh LỤC&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;chuỗi có khóa nhưng ĐỘC LẬP nội dung, dẫn từ K ‖ W ‖ H — cho phép trả lời câu hỏi &quot;ảnh này có mang dấu của khóa này không&quot; ngay cả khi mọi khối nội dung đều hỏng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="526" height="88" as="geometry"/></mxCell>
        <mxCell id="c11" value="Bit dấu hiệu khớp ≥ 75 %?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="500" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="NotWatermarked&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;chưa đánh dấu, sai khóa, hoặc dấu bị phá hoàn toàn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="490" width="260" height="56" as="geometry"/></mxCell>
        <mxCell id="c13" value="Mọi khối tái tính đều khớp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="580" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c14" value="Intact&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;ảnh nguyên vẹn từng bit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="570" width="260" height="56" as="geometry"/></mxCell>
        <mxCell id="c15" value="Tampered&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;kèm danh sách khối hỏng ⇒ định vị được vùng bị sửa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="570" width="286" height="56" as="geometry"/></mxCell>
