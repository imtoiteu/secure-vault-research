        <mxCell id="c65" value="add_item(&amp;amp;session, source, name)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337.0" y="200.6" width="180.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c66" value="1. Kiểm tra tên khác rỗng; stat(source): nếu &amp;gt; 2 GiB trả SV-TOO-LARGE trước khi đọc bất kỳ byte nào" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="543.0" y="237.6" width="640" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c67" value="2. Lấy khóa ghi theo đường dẫn két đã chuẩn hóa — giữ suốt chu trình đọc-sửa-ghi để hai lệnh đồng thời không mất cập nhật" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="543.0" y="291.6" width="640" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c68" value="3. decode(bytes): xác minh chữ ký trên gốc ràng buộc TRƯỚC mọi thao tác khóa" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="338.6" width="640.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c69" value="OpenedContainer { header, payload }" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="368.6" width="640.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c70" value="4. derive_wrap_key(MK, WrapField::AgeIdentity, vault_uuid)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="386.1" width="200.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c71" value="Key32 — tự xóa khi hủy" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="441.6" width="200.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c72" value="5. secretbox::open(khóa bọc, wrapped_age_identity); thất bại ⇒ SV-UNAUTHORIZED" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="543.0" y="478.6" width="640" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c73" value="6. decrypt(payload, identity) → age -d với danh tính trong tệp tạm 0600" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="512.6" width="420.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c74" value="Kho lưu trữ dạng rõ (bị xóa sạch ngay sau khi dùng)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="542.6" width="420.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c75" value="7. unpack_archive → ItemDirectory + vùng byte nội dung" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="572.6" width="640.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c76" value="8. Đọc tệp nguồn, sinh item_id 16 byte ngẫu nhiên, tính BLAKE3 nội dung" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="543.0" y="609.6" width="640" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c77" value="9. pack_archive(toàn bộ mục cũ + mục mới) → kho lưu trữ mới" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="643.6" width="640.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c78" value="10. encrypt(archive, age_recipient) → PAYLOAD mới" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="673.6" width="420.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c79" value="11. Mở bọc khóa ký; encode() tính lại gốc ràng buộc và ký lại" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="691.1" width="200.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c80" value="12. write_atomic: tệp tạm cùng thư mục → fsync → rename" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="537.0" y="746.6" width="640.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c81" value="ItemInfo { item_id, name, size_bytes, content_hash_hex } — không chứa bí mật" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337.0" y="751.6" width="180.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c82" value="Kết quả, hoặc ApiError mang mã SV-* đã bản địa hóa" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="137.0" y="820.1" width="180.0" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c83" value="Thứ tự các cổng là điểm cốt lõi: chữ ký container được kiểm TRƯỚC khi mật khẩu được dùng, nên việc tệp bị sửa không thể bị lợi dụng làm oracle đoán mật khẩu." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="59" width="1220" height="26.4" as="geometry"/></mxCell>
