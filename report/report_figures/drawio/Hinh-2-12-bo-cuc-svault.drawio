  <diagram id="Hinh-2-12-bo-cuc-svault" name="Hinh-2-12-bo-cuc-svault">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 2.12 — Bố cục byte của container .svault và phạm vi chữ ký" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1128" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Định dạng tự mô tả: 4 byte MAGIC + phiên bản u16 LE, phân tích rẻ trước mọi thao tác mật mã" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1128" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="MAGIC&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;&quot;SVLT&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="120" height="84" as="geometry"/></mxCell>
        <mxCell id="c4" value="FORMAT_VERSION&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;u16 LE = 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="170" y="130" width="130" height="84" as="geometry"/></mxCell>
        <mxCell id="c5" value="HEADER_LEN&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;u32 LE&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="120" height="84" as="geometry"/></mxCell>
        <mxCell id="c6" value="HEADER (CBOR)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;≤ 1 MiB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="250" height="84" as="geometry"/></mxCell>
        <mxCell id="c7" value="PAYLOAD&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;một khối mã age&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="260" height="84" as="geometry"/></mxCell>
        <mxCell id="c8" value="SIG_TRAILER&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;định dạng minisign&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="130" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="c9" value="header_digest = BLAKE3(byte 0 … 10+HEADER_LEN)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="268" width="370" height="62" as="geometry"/></mxCell>
        <mxCell id="c10" value="payload_digest = BLAKE3(PAYLOAD)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="268" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c11" value="Gốc ràng buộc = BLAKE3(header_digest ‖ payload_digest)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="366" width="420" height="66" as="geometry"/></mxCell>
        <mxCell id="c12" value="Chữ ký Ed25519 định dạng minisign trên gốc ràng buộc&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;tiền băm BLAKE2b-512, kèm chữ ký toàn cục ràng buộc trusted comment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="460" width="420" height="62" as="geometry"/></mxCell>
        <mxCell id="c13" value="Không lưu hai bản tóm lược&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;header_digest và payload_digest được tính lại mỗi lần đọc, không nằm trong tệp. Vì thế header của tệp A không thể ghép với payload của tệp B: gốc ràng buộc thay đổi và chữ ký lập tức sai.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="268" width="220" height="254" as="geometry"/></mxCell>
        <mxCell id="c14" value="Bên trong PAYLOAD sau khi giải mã&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;DIR_LEN (u32 LE) ‖ CBOR(ItemDirectory) ‖ byte của các mục nối tiếp nhau — danh mục tệp do đó cũng được mã hóa và không lộ khi két đang khóa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="1080" height="84" as="geometry"/></mxCell>
