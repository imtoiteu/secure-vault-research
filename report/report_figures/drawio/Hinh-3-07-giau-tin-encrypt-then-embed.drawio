  <diagram id="Hinh-3-07-giau-tin-encrypt-then-embed" name="Hinh-3-07-giau-tin-encrypt-then-embed">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 3.7 — Kiến trúc giấu tin theo nguyên tắc mã hóa-rồi-nhúng" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1168" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Che giấu KHÔNG phải là bí mật: toàn bộ tính bí mật nằm ở tầng AEAD, không nằm ở tầng sóng mang" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1168" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Tầng bí mật + toàn vẹn — RANH GIỚI AN TOÀN DUY NHẤT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#9CCBA9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="560" height="270" as="geometry"/></mxCell>
        <mxCell id="z1" value="Tầng che giấu — KHÔNG tuyên bố bất kỳ tính bí mật nào" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F8;strokeColor=#B9C0C9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="92" width="500" height="270" as="geometry"/></mxCell>
        <mxCell id="c3" value="Dữ liệu cần giấu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="136" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="c4" value="Mật khẩu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="204" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="c5" value="Muối 16 byte công khai&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;nằm trong header SVSTEG&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="272" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="c6" value="Argon2idSecretboxSealer&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Argon2id(mật khẩu, muối) → Key32; secretbox seal/open. Không hề có nguyên thủy mật mã mới nào được tạo ra ở đây.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="176" width="236" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="Ảnh bìa&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;PNG / BMP / JPEG&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="674" y="136" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="c8" value="Carrier&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Spatial (LSB) hoặc Jpeg (hệ số DCT)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="136" width="216" height="56" as="geometry"/></mxCell>
        <mxCell id="c9" value="capacity::fits — chặn tải quá dung lượng TRƯỚC khi chạy Argon2id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="674" y="204" width="452" height="52" as="geometry"/></mxCell>
        <mxCell id="c10" value="SiteSelector: Sequential hoặc Permuted&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;hoán vị Fisher–Yates một phần, hạt giống = BLAKE3(muối) — chỉ làm mờ dấu vết thống kê&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="674" y="268" width="452" height="60" as="geometry"/></mxCell>
        <mxCell id="c11" value="Khung SVSTEG — header 54 byte cố định, số nguyên big-endian&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;magic &quot;SVSTEG&quot; (6) ‖ version (1) ‖ flags (1: bit0 sóng mang JPEG, bit1 hoán vị, bit2 mặt bit &amp;gt; 0 dành riêng) ‖ kdf_alg (1) ‖ aead_alg (1) ‖ salt (16) ‖ nonce (24) ‖ ct_len u32 (4)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="1100" height="90" as="geometry"/></mxCell>
        <mxCell id="c12" value="LsbEmbedder::write_bits&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;432 vị trí đầu tiên mang header theo thứ tự tuần tự (để đọc được trước khi biết lịch hoán vị); phần thân đi theo lịch của SiteSelector&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="530" height="84" as="geometry"/></mxCell>
        <mxCell id="c13" value="Ảnh chứa tin, cùng định dạng vật chứa&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;PNG/BMP mã hóa lại không mất mát; JPEG ghi lại ở miền hệ số lượng tử hóa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="512" width="530" height="84" as="geometry"/></mxCell>
        <mxCell id="c14" value="Đường trích xuất và tính chống dò oracle&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Ảnh sạch, sai mật khẩu, sóng mang bị sửa và khung bị cắt cụt đều trả về NoPayload / BadFrame / AuthFailed — cả ba đều gộp thành đúng một mã SV-UNAUTHORIZED. Kẻ tấn công thậm chí không biết được một tấm ảnh CÓ mang dữ liệu hay không. Chỉ ảnh không giải mã nổi mới là SV-MALFORMED.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="618" width="1100" height="92" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="edgeStyle=none;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;exitPerimeter=1;entryPerimeter=1;strokeColor=#5B6675;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#3A5060;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
