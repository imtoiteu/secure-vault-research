        <mxCell id="ttl" value="Hình 2.10 — Quy trình mã hóa và niêm phong két (đường ghi)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1168" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Trình tự thực tế: đóng gói → mã hóa age → ký gốc ràng buộc → ghi nguyên tử" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1168" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="Danh sách mục dạng rõ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;mục đã có + mục mới thêm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="220" height="76" as="geometry"/></mxCell>
        <mxCell id="c4" value="pack_archive&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;DIR_LEN ‖ CBOR(ItemDirectory) ‖ byte nội dung&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="220" height="76" as="geometry"/></mxCell>
        <mxCell id="c5" value="Kho lưu trữ dạng rõ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;danh mục tệp nằm BÊN TRONG vùng sẽ được mã hóa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="220" height="76" as="geometry"/></mxCell>
