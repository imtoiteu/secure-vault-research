        <mxCell id="c39" value="Hai điểm quan trọng: (1) sv-core chỉ phụ thuộc ABI trong bản dựng sản phẩm; (2) tiến trình con age chỉ được nối dây ở gốc lắp ghép, nên phụ thuộc nhị phân ngoài không lan vào tầng nghiệp vụ." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="734.2" width="1040" height="25.92" as="geometry"/></mxCell>
