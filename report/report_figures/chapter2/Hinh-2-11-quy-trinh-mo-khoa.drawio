        <mxCell id="c30" value="Đường khôi phục bằng mảnh (recover) đi theo đúng khung này, chỉ khác ở chỗ MK được tái tạo bằng SssSharer::combine thay vì Argon2id; cổng tín nhiệm cuối cùng vẫn là phép mở bọc danh tính age, nên hai đường thất bại theo cùng một cách." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="819" width="1000" height="26.4" as="geometry"/></mxCell>
