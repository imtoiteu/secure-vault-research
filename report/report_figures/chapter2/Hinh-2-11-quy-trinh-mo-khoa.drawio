        <mxCell id="c15" value="SV-UNAUTHORIZED&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;sai mật khẩu HOẶC sai mảnh khôi phục — hợp nhất một mã&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="650" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="c16" value="Vì sao thứ tự này quan trọng?&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Cổng chữ ký nằm TRƯỚC cổng mật khẩu và không dùng đến bất kỳ thông tin bí mật nào. Nhờ vậy kết quả &quot;tệp bị sửa&quot; không thể bị dùng làm tín hiệu phân biệt mật khẩu đúng/sai. Ngược lại, mọi thất bại ở cổng mật khẩu đều trả về đúng một mã duy nhất.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B8A429;fontColor=#4A4210;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="250" height="300" as="geometry"/></mxCell>
