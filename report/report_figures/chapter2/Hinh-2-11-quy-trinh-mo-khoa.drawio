        <mxCell id="c11" value="Tạo phiên: session_id ngẫu nhiên 32 byte ↦ (MK, đường dẫn)&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;chỉ khóa chủ được giữ; danh tính và khóa ký sinh lại theo từng thao tác&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=11;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="728" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="SV-MALFORMED&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;không phải tệp két&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="250" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="c13" value="SV-INCOMPATIBLE-VERSION&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;phiên bản định dạng lạ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="320" width="260" height="58" as="geometry"/></mxCell>
