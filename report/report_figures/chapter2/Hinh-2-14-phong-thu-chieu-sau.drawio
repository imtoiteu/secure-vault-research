<mxfile host="secure-vault-report" modified="2026-08-20T00:00:00.000Z" agent="figlib" version="24.7.7" type="device">
  <diagram id="Hinh-2-14-phong-thu-chieu-sau" name="Hinh-2-14-phong-thu-chieu-sau">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="Hình 2.14 — Kiến trúc phòng thủ theo chiều sâu bảo vệ dữ liệu" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1108" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Bảy lớp kiểm soát; mỗi lớp có cơ chế và bằng chứng mã nguồn riêng" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1108" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="L7 · Kỷ luật dự án&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Không tự chế nguyên thủy · unsafe bị cấm toàn workspace · cargo deny/audit · CI ba hệ điều hành&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#5B6675;fontColor=#1C2330;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="1060" height="76" as="geometry"/></mxCell>
        <mxCell id="c4" value="L6 · Kiểm soát tài nguyên&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Trần 2 GiB cho tệp · header ≤ 1 MiB · trần Argon2 trước xác thực · chặn bom giải nén ảnh · hạn giờ tường&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="188" width="1020" height="76" as="geometry"/></mxCell>
        <mxCell id="c5" value="L5 · Làm cứng tiến trình con&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Ghim băm BLAKE3 · kiểm kiến trúc lúc build · env_clear · không shell · thư mục làm việc riêng · -config &quot;&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="280" width="980" height="76" as="geometry"/></mxCell>
        <mxCell id="c6" value="L4 · An toàn dữ liệu&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Ghi nguyên tử temp+rename · từ chối ghi đè · khóa ghi theo két · tên tệp gốc nằm trong vùng mã hóa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="372" width="940" height="76" as="geometry"/></mxCell>
        <mxCell id="c7" value="L3 · Toàn vẹn và xuất xứ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Chữ ký Ed25519 trên gốc ràng buộc · BLAKE3 từng mục · thẻ AEAD trên mọi bản mã&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#5A3600;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="464" width="900" height="76" as="geometry"/></mxCell>
        <mxCell id="c8" value="L2 · Bí mật trong bộ nhớ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Key32/SecretBytes/KeyShare tự xóa · Debug bị che · không Serialize · bí mật chỉ tồn tại theo thao tác&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#B5197F;fontColor=#5A0C3E;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="556" width="860" height="76" as="geometry"/></mxCell>
        <mxCell id="c9" value="L1 · Bí mật khi lưu trữ&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;age (X25519+ChaCha20-Poly1305) cho tải trọng · Argon2id + secretbox cho khóa và tệp độc lập&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#7A3FBF;fontColor=#3A1560;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="170" y="648" width="820" height="76" as="geometry"/></mxCell>
        <mxCell id="c10" value="DỮ LIỆU CỦA NGƯỜI DÙNG" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B3261E;fontColor=#5E1611;fontSize=14;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="746" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c11" value="Mô hình lỗi chống dò oracle là lớp cắt ngang: nó áp lên mọi lớp phía trên bằng cách hợp nhất mọi thất bại chứng thực về đúng một mã SV-UNAUTHORIZED, đồng thời giữ nguyên tính hành động được của các tình huống lành tính (sai tệp, sai phiên bản, thiếu mảnh, tệp quá lớn, hết giờ, đích đã tồn tại)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="829" width="1060" height="26.4" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Nguon: docs/architecture/06-security-design.md §6.1–6.8; docs/M7-HARDENING.md" style="text;html=1;align=left;fontSize=10;fontColor=#77808C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="834" width="1108" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
