        <mxCell id="ttl" value="Hình 2.6 — Kiến trúc triển khai và thực thi trên máy người dùng" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="12" width="1108" height="28" as="geometry"/></mxCell>
        <mxCell id="sub" value="Một tiến trình, một webview, hai họ tiến trình con, không có tiến trình nền hay cổng mạng" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5B6675;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="26" y="40" width="1108" height="20" as="geometry"/></mxCell>
        <mxCell id="z0" value="Máy của người dùng (Windows / macOS / Linux)&lt;br&gt;&lt;font style=&apos;font-size:9px;color:#67707d&apos;&gt;Không yêu cầu quyền quản trị; không có dịch vụ nền&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F8;strokeColor=#B9C0C9;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1060" height="560" as="geometry"/></mxCell>
        <mxCell id="z1" value="Tiến trình ứng dụng Secure Vault" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#8FC8A3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="128" width="620" height="300" as="geometry"/></mxCell>
        <mxCell id="z2" value="Tài nguyên đi kèm gói cài&lt;br&gt;&lt;font style=&apos;font-size:9px;color:#67707d&apos;&gt;bundle.resources: binaries/**/*&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6F5;strokeColor=#E0A29B;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="128" width="340" height="300" as="geometry"/></mxCell>
        <mxCell id="z3" value="Hệ thống tệp cục bộ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBFB;strokeColor=#8CC6C6;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#3B4655;container=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="452" width="1000" height="168" as="geometry"/></mxCell>
        <mxCell id="c3" value="Luồng WebView&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;WebView2 / WKWebView / WebKitGTK · CSP default-src &apos;self&apos;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B6FD4;fontColor=#12305F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="106" y="176" width="270" height="84" as="geometry"/></mxCell>
        <mxCell id="c4" value="Luồng lõi Rust&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;bộ điều phối lệnh Tauri (thread pool)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="176" width="274" height="84" as="geometry"/></mxCell>
        <mxCell id="c5" value="Năm trạng thái quản lý được đăng ký lúc khởi động&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Backend = AppVault&amp;lt;AgePayloadCipher&amp;gt; · Platform · Stego · Meta (bật/tắt an toàn) · Watermark; bảng phiên giữ duy nhất khóa chủ theo SessionHandle&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#12401F;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="106" y="292" width="568" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="age · age-keygen&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;bắt buộc — thiếu thì bản release lỗi build&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="766" y="176" width="288" height="60" as="geometry"/></mxCell>
        <mxCell id="c7" value="exiftool&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;tùy chọn — thiếu thì tắt mô-đun an toàn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#5E1611;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="766" y="250" width="288" height="60" as="geometry"/></mxCell>
        <mxCell id="c8" value="Băm BLAKE3 được ghim lúc biên dịch&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;kiểm tra lại khi khởi tạo bộ điều hợp; sai băm là từ chối chạy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F5E7;strokeColor=#1E7B34;fontColor=#0E3A19;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="766" y="324" width="288" height="78" as="geometry"/></mxCell>
        <mxCell id="c9" value=".svault&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;MAGIC SVLT · header CBOR đã ký · tải trọng age&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#EAF6F6;strokeColor=#0F7B7B;fontColor=#0A3D3D;fontSize=12;fontStyle=1;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="106" y="500" width="220" height="96" as="geometry"/></mxCell>
