        <mxCell id="c28" value="Header hoàn toàn KHÔNG chứa danh mục tệp. Mọi thông tin về nội dung — tên tệp, kích thước, số lượng — đều nằm trong vùng đã mã hóa. Đây là quyết định thiết kế H3 của lược đồ M5." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="619" width="500" height="26.4" as="geometry"/></mxCell>
        <mxCell id="c29" value="deny_unknown_fields là lớp phòng vệ bổ sung phía trên chữ ký: một header có trường lạ bị từ chối ngay ở bước giải mã CBOR." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="689" width="500" height="26.4" as="geometry"/></mxCell>
