        <mxCell id="c48" value="Sinh vault_uuid 16 byte và muối Argon2id 16 byte" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="232.1" width="200" height="24.96" as="geometry"/></mxCell>
        <mxCell id="c49" value="Argon2id(mật khẩu, muối, tham số mặc định 256 MiB / t=3 / p=1) → khóa chủ MK" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#2f3d4c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="348" y="296.6" width="700" height="24.96" as="geometry"/></mxCell>
