        <mxCell id="c59" value="Nếu chính sách khôi phục được bật, các mảnh KHÔNG được sinh ở bước này: két chỉ ghi lại chính sách (n, k); mảnh thật chỉ được cắt khi người dùng gọi keys_split trên một phiên đã mở khóa." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#3a4a5a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="59" width="1200" height="26.4" as="geometry"/></mxCell>
