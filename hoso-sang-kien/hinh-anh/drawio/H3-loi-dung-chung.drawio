<mxfile host="SecureVault" modified="2026-09-08T00:00:00.000Z" agent="tao-so-do.py" version="24.0.0">
  <diagram id="H3-loi-dung-chung" name="Hình 3. Một lõi bảo mật, hai gốc hợp thành theo nền tảng">
    <mxGraphModel dx="1040" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Hình 3. Một lõi bảo mật, hai gốc hợp thành theo nền tảng" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Rào cản kỹ thuật và cách giải quyết đã được kiểm chứng bằng thực nghiệm" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;Lõi bảo mật dùng chung (15 thành phần Rust)&lt;/b&gt;&lt;br/&gt;định dạng .svault, phân cấp khoá, mật mã, phân loại lỗi&lt;br/&gt;GIỐNG HỆT NHAU trên mọi nền tảng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="92" width="440" height="84" as="geometry"/></mxCell>
        <mxCell id="cfgd" value="Biên dịch với cfg = desktop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#6B7280;fontColor=#1F2933;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="244" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="cfgm" value="Biên dịch với cfg = mobile (Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="244" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="dsk" value="&lt;b&gt;compose/desktop.rs&lt;/b&gt;&lt;br/&gt;tiến trình con age/age-keygen ghim băm BLAKE3&lt;br/&gt;ExifTool cho siêu dữ liệu&lt;br/&gt;(không thuộc phạm vi hồ sơ này)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#6B7280;fontColor=#1F2933;dashed=1;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="380" height="108" as="geometry"/></mxCell>
        <mxCell id="mob" value="&lt;b&gt;compose/mobile.rs&lt;/b&gt;&lt;br/&gt;RustAgePayloadCipher — mã hoá két trong tiến trình&lt;br/&gt;RustMetaApp — siêu dữ liệu bằng Rust thuần&lt;br/&gt;không sinh tiến trình con" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="380" height="108" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;Vì sao bắt buộc phải thay đổi:&lt;/b&gt;&lt;br/&gt;iOS cấm sinh tiến trình; Android chặn thực thi&lt;br/&gt;tệp nhị phân trong vùng ghi được của ứng dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="462" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="proof" value="&lt;b&gt;Hệ quả nếu không xử lý:&lt;/b&gt;&lt;br/&gt;toàn bộ chức năng két sẽ không hoạt động&lt;br/&gt;trên thiết bị di động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="462" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="bridge" value="&lt;b&gt;Cùng một nguyên tắc áp dụng cho hai thành phần: thay phần hiện thực bên dưới, giữ nguyên mọi thứ phía trên&lt;/b&gt;&lt;br/&gt;két vẫn liên thông giữa hai nền tảng; siêu dữ liệu là chức năng chạy thật trên di động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="556" width="860" height="56" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="176" as="sourcePoint"/><mxPoint x="280" y="244" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="176" as="sourcePoint"/><mxPoint x="760" y="244" as="targetPoint"/></mxGeometry></mxCell>
