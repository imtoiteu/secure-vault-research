        <mxCell id="title" value="Hình 6. Các mức kiểm chứng của sản phẩm" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Mỗi tuyên bố kỹ thuật trong hồ sơ đều gắn với một mức kiểm chứng cụ thể" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Mức 1 — Kiểm thử đơn vị trên máy chủ: 263 test, 0 lỗi&lt;/b&gt;&lt;br/&gt;toàn bộ lõi mật mã và nghiệp vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="96" width="560" height="66" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Mức 2 — Tương thích định dạng: 5 phép đối chứng&lt;/b&gt;&lt;br/&gt;hai chiều với age v1.2.1 thật, và mở chéo tệp .svault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="178" width="560" height="66" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;Mức 3 — Biên dịch chéo: 15 thành phần sang aarch64-linux-android&lt;/b&gt;&lt;br/&gt;kiểm chứng tệp đối tượng thực sự là mã ARM64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="560" height="66" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;Mức 4 — Thực thi trên ARM64 (giả lập QEMU): 146 test, 0 lỗi trên 10 bộ kiểm thử&lt;/b&gt;&lt;br/&gt;chạy thật mã lệnh ARM64 của lõi mật mã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="342" width="560" height="66" as="geometry"/></mxCell>
        <mxCell id="m5" value="&lt;b&gt;Mức 5 — Đóng gói APK và kiểm tra tĩnh&lt;/b&gt;&lt;br/&gt;thư viện .so đúng kiến trúc, không khai báo quyền mạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="424" width="560" height="66" as="geometry"/></mxCell>
        <mxCell id="m6" value="&lt;b&gt;Mức 6 — Nghiệm thu trên điện thoại Android&lt;/b&gt;&lt;br/&gt;quy trình 15 bước có tiêu chí đạt, tại Phụ lục A của Thuyết minh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="506" width="560" height="66" as="geometry"/></mxCell>
