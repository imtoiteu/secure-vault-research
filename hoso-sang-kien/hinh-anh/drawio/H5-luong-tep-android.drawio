        <mxCell id="title" value="Luồng xử lý tệp trên Android" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Mọi xử lý diễn ra trên thiết bị; không có kết nối mạng trong toàn bộ luồng" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="saf" value="&lt;b&gt;Bộ chọn tệp Android (SAF)&lt;/b&gt;&lt;br/&gt;trả về content:// URI&lt;br/&gt;người dùng cấp quyền từng tệp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="stage" value="&lt;b&gt;Vùng đệm riêng của ứng dụng&lt;/b&gt;&lt;br/&gt;sao chép tạm để lõi&lt;br/&gt;đọc bằng đường dẫn thật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;Lõi bảo mật (Rust)&lt;/b&gt;&lt;br/&gt;mã hoá / giải mã / ký / kiểm tra&lt;br/&gt;ghi tệp nguyên tử (tạm rồi đổi tên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="340" height="84" as="geometry"/></mxCell>
        <mxCell id="out" value="&lt;b&gt;Kết quả trả về người dùng&lt;/b&gt;&lt;br/&gt;lưu qua SAF hoặc chia sẻ&lt;br/&gt;bằng cơ chế của hệ điều hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="340" height="76" as="geometry"/></mxCell>
        <mxCell id="shred" value="&lt;b&gt;Xoá vùng đệm&lt;/b&gt;&lt;br/&gt;ghi đè rồi huỷ tệp tạm&lt;br/&gt;ngay khi thao tác kết thúc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="152" as="sourcePoint"/><mxPoint x="330" y="152" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="152" as="sourcePoint"/><mxPoint x="620" y="152" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="194" as="sourcePoint"/><mxPoint x="790" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="288" as="sourcePoint"/><mxPoint x="570" y="288" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n0" value="Ranh giới tin cậy: toàn bộ khối trên nằm trong vùng lưu trữ riêng của ứng dụng," style="text;html=1;fontSize=12.5;align=center;fontColor=#4B5768;" vertex="1" parent="1"><mxGeometry x="370" y="366" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="n1" value="được hệ điều hành cách ly và mã hoá ở mức tệp (File-Based Encryption)." style="text;html=1;fontSize=12.5;align=center;fontColor=#4B5768;" vertex="1" parent="1"><mxGeometry x="370" y="386" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="n2" value="Ứng dụng KHÔNG khai báo quyền truy cập mạng (INTERNET)." style="text;html=1;fontSize=13.5;align=center;fontColor=#2E7D4F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="426" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="n3" value="Điểm cần ghi nhận trung thực: bản sao tạm ở dạng rõ tồn tại trong vùng đệm" style="text;html=1;fontSize=12;align=center;fontColor=#B3403A;" vertex="1" parent="1"><mxGeometry x="370" y="456" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="n4" value="trong thời gian thao tác — đã được ghi nhận trong mô hình mối đe doạ." style="text;html=1;fontSize=12;align=center;fontColor=#B3403A;" vertex="1" parent="1"><mxGeometry x="370" y="476" width="300" height="20" as="geometry"/></mxCell>
