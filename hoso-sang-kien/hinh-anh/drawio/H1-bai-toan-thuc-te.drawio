<mxfile host="SecureVault" modified="2026-09-08T00:00:00.000Z" agent="tao-so-do.py" version="24.0.0">
  <diagram id="H1-bai-toan-thuc-te" name="Hai nhu cầu thực tiễn mà sáng kiến hướng tới">
    <mxGraphModel dx="1040" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Hai nhu cầu thực tiễn mà sáng kiến hướng tới" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Huấn luyện an toàn thông tin và bọc bảo vệ tệp trong tình huống khẩn cấp, bất khả kháng" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="nv" value="&lt;b&gt;Nhu cầu 1 — Huấn luyện&lt;/b&gt;&lt;br/&gt;học viên học mật mã trên lý&lt;br/&gt;thuyết và trên máy tính, chưa&lt;br/&gt;thao tác trên thiết bị di động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#6B7280;fontColor=#1F2933;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="dl" value="&lt;b&gt;Nhu cầu 2 — Tình huống khẩn cấp&lt;/b&gt;&lt;br/&gt;buộc phải chuyển gấp một số tài&lt;br/&gt;liệu đặc thù qua không gian mạng&lt;br/&gt;khi không còn phương án khác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBFA;strokeColor=#4C51BF;fontColor=#242A6B;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="240" height="92" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;1. Tệp bị chặn bắt&lt;/b&gt;&lt;br/&gt;trên đường truyền qua&lt;br/&gt;hạ tầng không kiểm soát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="262" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;2. Bên nhận không xác&lt;/b&gt;&lt;br/&gt;minh được nguồn gốc&lt;br/&gt;và tính toàn vẹn của tệp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="262" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="r3" value="&lt;b&gt;3. Siêu dữ liệu ẩn&lt;/b&gt;&lt;br/&gt;toạ độ GPS, thiết bị,&lt;br/&gt;tác giả đi kèm tệp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="262" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="r4" value="&lt;b&gt;4. Phụ thuộc bên thứ ba&lt;/b&gt;&lt;br/&gt;khoá và dữ liệu do&lt;br/&gt;nhà cung cấp nắm giữ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#B3403A;fontColor=#5F1B17;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="262" width="200" height="86" as="geometry"/></mxCell>
        <mxCell id="nc" value="&lt;b&gt;Nhu cầu: bộ công cụ chạy hoàn toàn trên thiết bị,&lt;/b&gt;&lt;br/&gt;không phụ thuộc mạng và dịch vụ bên ngoài, kiểm soát được&lt;br/&gt;mã nguồn, vừa dùng huấn luyện vừa đủ tin cậy khi cần dùng thật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="460" height="78" as="geometry"/></mxCell>
