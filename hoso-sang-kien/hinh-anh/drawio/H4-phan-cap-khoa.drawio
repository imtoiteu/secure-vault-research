  <diagram id="H4-phan-cap-khoa" name="Hình 4. Phân cấp khoá và luồng mở két an toàn">
    <mxGraphModel dx="1040" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
