        <mxCell id="title" value="Hình 4. Phân cấp khoá và luồng mở két an toàn" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Mật khẩu không bao giờ được lưu; khoá chính chỉ tồn tại trong bộ nhớ phiên" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="pw" value="&lt;b&gt;Mật khẩu người dùng&lt;/b&gt;&lt;br/&gt;chỉ tồn tại trong RAM,&lt;br/&gt;xoá sạch sau khi dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBFA;strokeColor=#4C51BF;fontColor=#242A6B;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="96" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="kdf" value="&lt;b&gt;Argon2id&lt;/b&gt;&lt;br/&gt;ngưỡng tối thiểu 19 MiB,&lt;br/&gt;2 vòng lặp (theo OWASP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="mk" value="&lt;b&gt;Khoá chính (MK)&lt;/b&gt;&lt;br/&gt;32 byte, chỉ trong&lt;br/&gt;bộ nhớ phiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="96" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Khoá bọc danh tính age&lt;/b&gt;&lt;br/&gt;(BLAKE3 derive_key)&lt;br/&gt;mở khoá nội dung két" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="246" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;Khoá bọc khoá ký&lt;/b&gt;&lt;br/&gt;(BLAKE3 derive_key)&lt;br/&gt;ký tệp bằng két" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="246" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Khoá phục hồi (tuỳ chọn)&lt;/b&gt;&lt;br/&gt;chia Shamir k trong n&lt;br/&gt;khôi phục khi mất mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="246" width="250" height="76" as="geometry"/></mxCell>
        <mxCell id="payload" value="&lt;b&gt;Nội dung két: một luồng age v1 (X25519 + ChaCha20-Poly1305)&lt;/b&gt;&lt;br/&gt;danh mục tệp được mã hoá; chữ ký minisign/Ed25519 ràng buộc phần đầu&lt;br/&gt;phát hiện được mọi sửa đổi hoặc ghép nối tệp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="392" width="520" height="76" as="geometry"/></mxCell>
