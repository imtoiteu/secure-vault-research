<mxfile host="SecureVault" modified="2026-09-08T00:00:00.000Z" agent="tao-so-do.py" version="24.0.0">
  <diagram id="H2-kien-truc-phan-lop" name="Kiến trúc phân lớp của SecureVault Mobile">
    <mxGraphModel dx="1040" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Kiến trúc phân lớp của SecureVault Mobile" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Sáu lớp, phụ thuộc một chiều từ trên xuống; lõi mật mã không phụ thuộc giao diện" style="text;html=1;fontSize=13;align=center;fontColor=#5A6779;" vertex="1" parent="1"><mxGeometry x="0" y="42" width="1040" height="20" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;L1 — Giao diện (WebView): HTML/CSS/JS tĩnh, song ngữ Việt–Anh&lt;/b&gt;&lt;br/&gt;ngăn kéo điều hướng, vùng chạm ≥ 44px, không có mã nội tuyến (CSP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3A6EA5;fontColor=#12325B;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="86" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;L2 — Vỏ ứng dụng (Tauri 2, thư mục app/): 38 lệnh #[tauri::command]&lt;/b&gt;&lt;br/&gt;gốc hợp thành riêng cho Android (compose/mobile.rs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C4772B;fontColor=#6B3E10;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="168" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;L3 — Bề mặt lệnh (sv-app): CommandSurface, Platform/Stego/Meta/Watermark&lt;/b&gt;&lt;br/&gt;IpcPassphrase, SessionHandle mờ, lỗi có mã an toàn (oracle-safe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;L4 — Nghiệp vụ: sv-core (.svault), sv-platform, sv-stego, sv-qr, sv-watermark&lt;/b&gt;&lt;br/&gt;không phụ thuộc backend cụ thể — chỉ phụ thuộc trait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="l5" value="&lt;b&gt;L5 — Bộ điều hợp: sv-crypto (BLAKE3, Argon2id, Shamir, minisign),&lt;/b&gt;&lt;br/&gt;sv-age-rs (age v1 thuần Rust) và sv-meta-rs (siêu dữ liệu thuần Rust)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="414" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="l6" value="&lt;b&gt;L6 — Nguyên hàm/FFI: libsodium (secretbox, Ed25519), hazmat.c (Shamir)&lt;/b&gt;&lt;br/&gt;biên dịch chéo sang aarch64-linux-android bằng NDK r28c / clang 19" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#14432A;dashed=0;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="496" width="800" height="62" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="148" as="sourcePoint"/><mxPoint x="520" y="168" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="230" as="sourcePoint"/><mxPoint x="520" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="312" as="sourcePoint"/><mxPoint x="520" y="332" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="394" as="sourcePoint"/><mxPoint x="520" y="414" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="endArrow=block;html=1;strokeColor=#55607A;dashed=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="476" as="sourcePoint"/><mxPoint x="520" y="496" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n0" value="Vùng xanh = lõi dùng chung, đã kiểm chứng bằng kiểm thử tự động; vùng cam = thành phần riêng cho di động" style="text;html=1;fontSize=12;align=left;fontColor=#4B5768;" vertex="1" parent="1"><mxGeometry x="60" y="586" width="300" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
