        <mxCell id="arch05-1" value="&lt;b&gt;ARCH-05 · Deployment Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=21;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="arch05-2" value="Runtime deployment: application bundle, bundled+pinned resources, hardened subprocess execution, and OS / user-filesystem interaction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5b6675;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1160" height="18" as="geometry"/></mxCell>
        <mxCell id="arch05-3" value="" style="endArrow=none;html=1;strokeColor=#aab2bf;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="80" as="sourcePoint"/><mxPoint x="1200" y="80" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch05-4" value="" style="endArrow=none;html=1;strokeColor=#aab2bf;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="914" as="sourcePoint"/><mxPoint x="1200" y="914" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch05-5" value="Secure Vault — Security &amp; Privacy Toolkit · v0.1.0   |   Source of truth: docs/architecture/ (01..10). SVGs used as visual reference only. See 12-drawio-architecture/README.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5b6675;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1160" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-6" value="Operating System  (macOS · Windows · Linux)  ·  no network" style="rounded=1;html=1;arcSize=3;container=1;collapsible=0;fillColor=none;strokeColor=#5d6b7c;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#5d6b7c;fontStyle=1;fontSize=12.5;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1160" height="692" as="geometry"/></mxCell>
        <mxCell id="arch05-7" value="Secure Vault application bundle  —  productName: Secure Vault · id: org.secure-vault.desktop · v0.1.0 · bundle.targets: all" style="rounded=1;html=1;arcSize=3;container=1;collapsible=0;fillColor=#fbfcfe;strokeColor=#46506a;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#46506a;fontStyle=1;fontSize=12.5;" vertex="1" parent="arch05-6"><mxGeometry x="30" y="46" width="690" height="612" as="geometry"/></mxCell>
        <mxCell id="arch05-8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Tauri 2 runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Rust core (sv-app + crates)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;+ system WebView (WebKit / WebView2 / WebKitGTK)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-7"><mxGeometry x="20" y="58" width="320" height="74" as="geometry"/></mxCell>
        <mxCell id="arch05-9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Frontend assets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;frontendDist: frontend/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;HTML · JS · CSS · icons (withGlobalTauri)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-7"><mxGeometry x="360" y="58" width="310" height="74" as="geometry"/></mxCell>
        <mxCell id="arch05-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="arch05-8" target="arch05-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-11" value="Resources  (bundle.resources: &quot;binaries/**/*&quot;)" style="rounded=1;html=1;arcSize=3;container=1;collapsible=0;fillColor=none;strokeColor=#6a4f9c;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#6a4f9c;fontStyle=1;fontSize=12.5;" vertex="1" parent="arch05-7"><mxGeometry x="20" y="154" width="650" height="282" as="geometry"/></mxCell>
        <mxCell id="arch05-12" value="&lt;b style=&quot;font-size:13px&quot;&gt;age&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;BLAKE3-pinned · mandatory&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;release fails to build if missing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-11"><mxGeometry x="18" y="40" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="arch05-13" value="&lt;b style=&quot;font-size:13px&quot;&gt;age-keygen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;BLAKE3-pinned · mandatory&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;vault identity generation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-11"><mxGeometry x="330" y="40" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="arch05-14" value="&lt;b style=&quot;font-size:13px&quot;&gt;ExifTool distribution&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;exiftool + lib/  (or windows .exe)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;self-staged + pinned · optional&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-11"><mxGeometry x="18" y="116" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="arch05-15" value="&lt;b style=&quot;font-size:13px&quot;&gt;pins embedded at build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;build.rs emit_pin → BLAKE3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;into the compiled binary&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f4f6f9;strokeColor=#5b6675;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-11"><mxGeometry x="330" y="116" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="arch05-16" value="&lt;b style=&quot;color:#46506a&quot;&gt;Runtime resolution&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;• Resolved from the bundled app-resource directory — no env var, no repository path in a packaged build.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;• Runtime re-verifies each binary's BLAKE3 pin before use; release refuses to run an unpinned mandatory binary.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;• SV_*_BIN environment overrides are honoured in debug builds only.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="arch05-11"><mxGeometry x="18" y="192" width="624" height="76" as="geometry"/></mxCell>
        <mxCell id="arch05-17" value="&lt;b style=&quot;font-size:13px&quot;&gt;Spawned as hardened subprocess&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;env_clear · wall-clock timeout · -config '' (ExifTool) · fail-closed when a tool is absent/unpinned&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-7"><mxGeometry x="20" y="458" width="650" height="56" as="geometry"/></mxCell>
        <mxCell id="arch05-18" value="resolve + verify pin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch05-12" target="arch05-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch05-14" target="arch05-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-20" value="&lt;b style=&quot;font-size:13px&quot;&gt;User data on filesystem&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;.svault  ·  .svenc / .svkey  ·  .minisig&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;.svshare / .svss  ·  QR .png  ·  images  ·  keys&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;(under the user's own directories)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-6"><mxGeometry x="760" y="104" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="arch05-21" value="&lt;b style=&quot;font-size:13px&quot;&gt;OS integration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;File dialogs (tauri-plugin-dialog)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Open / reveal in folder (tauri-plugin-opener)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;CSPRNG: getrandom / libsodium&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-6"><mxGeometry x="760" y="248" width="360" height="96" as="geometry"/></mxCell>
        <mxCell id="arch05-22" value="&lt;b style=&quot;font-size:13px&quot;&gt;Process sandbox surface&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;WebView ↔ Rust via IPC (no fs: / shell: to page)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;atomic temp → fsync → rename writes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;refuse-overwrite · path-stripped errors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch05-6"><mxGeometry x="760" y="368" width="360" height="92" as="geometry"/></mxCell>
        <mxCell id="arch05-23" value="&lt;b style=&quot;color:#b0413f&quot;&gt;Out of scope (internal use)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;• Code signing / notarization (hardening item H5)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;• Per-OS signed installer for public distribution&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Per-OS bundle internals (.app / .msi / AppImage) differ;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;the logical structure shown is OS-agnostic.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Bundling itself (active, targets: all) is configured.&lt;/span&gt;" style="rounded=1;html=1;arcSize=6;fillColor=#fff8f8;strokeColor=#b0413f;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="arch05-6"><mxGeometry x="760" y="504" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="arch05-24" value="read / atomic write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch05-8" target="arch05-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-25" value="IPC results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="arch05-9" target="arch05-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="arch05-8" target="arch05-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch05-27" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="802" width="320" height="129" as="geometry"/></mxCell>
        <mxCell id="arch05-28" value="" style="rounded=0;html=1;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="833" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch05-29" value="Application runtime / native" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="831" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-30" value="" style="rounded=0;html=1;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="852" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch05-31" value="Frontend assets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="850" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-32" value="" style="rounded=0;html=1;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="871" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch05-33" value="Bundled resources / external tool" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="869" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-34" value="" style="rounded=0;html=1;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52" y="890" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch05-35" value="" style="ellipse;html=1;fillColor=#b0413f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="891" width="5" height="5" as="geometry"/></mxCell>
        <mxCell id="arch05-36" value="Security-critical (pinned binary)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="888" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-37" value="" style="rounded=0;html=1;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="909" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch05-38" value="OS / user filesystem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="907" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-39" value="&lt;b style=&quot;color:#1c2330&quot;&gt;Deployment notes&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="802" width="820" height="110" as="geometry"/></mxCell>
        <mxCell id="arch05-40" value="• The system WebView engine is OS-provided (WebKit / WebView2 / WebKitGTK) — only the Rust binary," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="831" width="796" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-41" value="   the static frontend assets, and the BLAKE3-pinned tool binaries are bundled." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="850" width="796" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-42" value="• A packaged build needs no env var, external setup, or repo path: tools resolve from app resources, pin-verified." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="869" width="796" height="16" as="geometry"/></mxCell>
        <mxCell id="arch05-43" value="• ExifTool is optional and fail-closed: absence disables only the Analysis module; the rest of the toolkit is unaffected." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="888" width="796" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
