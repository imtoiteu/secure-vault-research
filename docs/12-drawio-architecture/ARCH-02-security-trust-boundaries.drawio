        <mxCell id="arch02-2" value="Trust zones from untrusted user input through the sandboxed WebView, the trusted native backend and crypto core, to hardened subprocesses and storage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5b6675;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1160" height="18" as="geometry"/></mxCell>
