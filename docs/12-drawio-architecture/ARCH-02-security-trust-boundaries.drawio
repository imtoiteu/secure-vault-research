        <mxCell id="arch02-5" value="Secure Vault — Security &amp; Privacy Toolkit · v0.1.0   |   Source of truth: docs/architecture/ (01..10). SVGs used as visual reference only. See 12-drawio-architecture/README.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5b6675;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1160" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="92" width="1100" height="58" as="geometry"/></mxCell>
        <mxCell id="arch02-7" value="&lt;b style=&quot;color:#ffffff&quot;&gt;UNTRUSTED&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#5d6b7c;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="105" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-8" value="&lt;b&gt;User input&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="104" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-9" value="File paths, passphrases, images selected by the user — treated as untrusted input." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="128" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-10" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="176" width="1100" height="96" as="geometry"/></mxCell>
        <mxCell id="arch02-11" value="&lt;b style=&quot;color:#ffffff&quot;&gt;SANDBOXED&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#2f6ab0;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="189" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-12" value="&lt;b&gt;Frontend — Tauri WebView (static withGlobalTauri)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="188" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-13" value="CSP: default-src 'self'; no inline scripts.   Capability allowlist: core / dialog / opener only — no fs: / shell:." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="212" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-14" value="Renders all values via textContent (no HTML injection).   Password fields zeroed on navigation and after each task." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="226.5" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-15" value="" style="endArrow=none;html=1;strokeColor=#b0413f;strokeWidth=1.6;dashed=1;dashPattern=9 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="300" as="sourcePoint"/><mxPoint x="1170" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch02-16" value="&lt;b style=&quot;color:#b0413f&quot;&gt;IPC TRUST BOUNDARY  (JSON)&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=#b0413f;strokeWidth=1.3;fontColor=#b0413f;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="515" y="287" width="210" height="26" as="geometry"/></mxCell>
        <mxCell id="arch02-17" value="Crosses the boundary: file paths + passphrase (zeroizing) — never secret bytes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="308" width="1100" height="14" as="geometry"/></mxCell>
        <mxCell id="arch02-18" value="Documented residual: serde/JSON copies the passphrase into buffers it cannot zeroize (mitigate via OS disk/swap encryption; exclude these commands from arg logging)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="322" width="1100" height="14" as="geometry"/></mxCell>
        <mxCell id="arch02-19" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="348" width="1100" height="92" as="geometry"/></mxCell>
        <mxCell id="arch02-20" value="&lt;b style=&quot;color:#ffffff&quot;&gt;TRUSTED&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#46506a;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="361" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-21" value="&lt;b&gt;Backend — Rust command surface (sv-app)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="360" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-22" value="38 commands · coded, oracle-safe ApiError (wrong-passphrase = wrong-share = Unauthorized)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="384" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-23" value="IpcPassphrase zeroizing · no secret in any DTO · size + decompression-bomb caps · atomic refuse-overwrite writes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="398.5" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-24" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="452" width="1100" height="100" as="geometry"/></mxCell>
        <mxCell id="arch02-25" value="&lt;b style=&quot;color:#ffffff&quot;&gt;CRITICAL&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#b0413f;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="465" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-26" value="&lt;b&gt;Cryptographic services — shared platform + vault key hierarchy&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="464" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-27" value="BLAKE3 · Argon2id · libsodium secretbox / Ed25519-minisign · Shamir.   Signature verified BEFORE the credential gate." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="488" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-28" value="Key32 / SecretBytes zeroize-on-drop · vault master key is RAM-only and never written to disk." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="502.5" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-29" value="" style="ellipse;html=1;fillColor=#b0413f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1154" y="461" width="7" height="7" as="geometry"/></mxCell>
        <mxCell id="arch02-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch02-19" target="arch02-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch02-31" value="" style="endArrow=none;html=1;strokeColor=#b0413f;strokeWidth=1.6;dashed=1;dashPattern=9 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="580" as="sourcePoint"/><mxPoint x="1170" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch02-32" value="&lt;b style=&quot;color:#b0413f&quot;&gt;PROCESS BOUNDARY&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=#b0413f;strokeWidth=1.3;fontColor=#b0413f;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="567" width="140" height="26" as="geometry"/></mxCell>
        <mxCell id="arch02-33" value="env_clear · BLAKE3 hash-pin · wall-clock timeout · fail-closed" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5b6675;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="588" width="470" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-34" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="1100" height="84" as="geometry"/></mxCell>
        <mxCell id="arch02-35" value="&lt;b style=&quot;color:#ffffff&quot;&gt;EXTERNAL&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#6a4f9c;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="623" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-36" value="&lt;b&gt;Bundled external tools — hardened subprocess&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="622" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-37" value="age / age-keygen (file encryption) · ExifTool (metadata).   Spawned with env_clear, a pinned BLAKE3 hash," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="646" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-38" value="a wall-clock timeout, and -config '' for ExifTool (RCE vector closed).   Disabled tool ⇒ fail-closed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="660.5" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-39" value="" style="endArrow=none;html=1;strokeColor=#b0413f;strokeWidth=1.6;dashed=1;dashPattern=9 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="722" as="sourcePoint"/><mxPoint x="1170" y="722" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch02-40" value="&lt;b style=&quot;color:#b0413f&quot;&gt;I/O BOUNDARY&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=#b0413f;strokeWidth=1.3;fontColor=#b0413f;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="564" y="709" width="112" height="26" as="geometry"/></mxCell>
        <mxCell id="arch02-41" value="atomic temp → fsync → rename · refuse-overwrite · path-stripped errors" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5b6675;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="730" width="470" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-42" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="70" y="752" width="1100" height="70" as="geometry"/></mxCell>
        <mxCell id="arch02-43" value="&lt;b style=&quot;color:#ffffff&quot;&gt;STORAGE&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#5d6b7c;strokeColor=none;fontColor=#ffffff;fontSize=10.5;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="84" y="765" width="130" height="24" as="geometry"/></mxCell>
        <mxCell id="arch02-44" value="&lt;b&gt;File system&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=13.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="764" width="926" height="18" as="geometry"/></mxCell>
        <mxCell id="arch02-45" value=".svault · .svenc / .svkey · .minisig · .svshare / .svss · QR PNG · images · keys — all under the user's own paths." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228" y="788" width="926" height="15" as="geometry"/></mxCell>
        <mxCell id="arch02-46" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="858" width="290" height="148" as="geometry"/></mxCell>
        <mxCell id="arch02-47" value="" style="rounded=0;html=1;fillColor=#eceff3;strokeColor=#5d6b7c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="82" y="889" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch02-48" value="Untrusted input / storage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="887" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-49" value="" style="rounded=0;html=1;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="82" y="908" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch02-50" value="Sandboxed WebView" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="906" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-51" value="" style="rounded=0;html=1;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="82" y="927" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch02-52" value="Trusted native backend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="925" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-53" value="" style="rounded=0;html=1;fillColor=#fbe9e9;strokeColor=#b0413f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="82" y="946" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch02-54" value="" style="ellipse;html=1;fillColor=#b0413f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="93" y="947" width="5" height="5" as="geometry"/></mxCell>
        <mxCell id="arch02-55" value="Security-critical crypto" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="944" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-56" value="" style="rounded=0;html=1;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="82" y="965" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch02-57" value="External process (sandboxed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="963" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-58" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#b0413f;strokeWidth=1.7;dashed=1;dashPattern=5 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="82" y="990" as="sourcePoint"/><mxPoint x="100" y="990" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch02-59" value="trust / process / I-O boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="108" y="982" width="242" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-60" value="&lt;b style=&quot;color:#1c2330&quot;&gt;Boundary controls (defence in depth)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="372" y="858" width="798" height="129" as="geometry"/></mxCell>
        <mxCell id="arch02-61" value="1. WebView → backend: typed IPC only; no direct filesystem or shell access is granted to the page." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="384" y="887" width="774" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-62" value="2. Backend → crypto: secrets stay in zeroizing types; the vault signature is checked before any passphrase test," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="384" y="906" width="774" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-63" value="    so tampering is reported as Corrupted, never as an authentication oracle." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="384" y="925" width="774" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-64" value="3. Backend → tools: external binaries run as cleaned, hash-pinned, time-bounded subprocesses and fail closed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="384" y="944" width="774" height="16" as="geometry"/></mxCell>
        <mxCell id="arch02-65" value="4. Anything → disk: writes are atomic and refuse to overwrite; error details are path-stripped." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="384" y="963" width="774" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
