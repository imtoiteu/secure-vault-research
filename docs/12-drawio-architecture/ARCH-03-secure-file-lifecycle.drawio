        <mxCell id="arch03-12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Plaintext&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;file or secret&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;(user input)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f4f6f9;strokeColor=#5b6675;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="30" y="279" width="110" height="150" as="geometry"/></mxCell>
        <mxCell id="arch03-13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Recovered&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;plaintext file&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;or secret&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f4f6f9;strokeColor=#5b6675;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1350" y="279" width="110" height="150" as="geometry"/></mxCell>
        <mxCell id="arch03-14" value="Vault path  (sv-core)" style="swimlane;html=1;horizontal=0;startSize=120;rounded=1;arcSize=3;fillColor=none;swimlaneFillColor=none;strokeColor=#3c7d4f;strokeWidth=1.3;dashed=1;dashPattern=4 4;fontColor=#3c7d4f;fontStyle=1;fontSize=12;verticalAlign=middle;align=center;collapsible=0;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="1180" height="110" as="geometry"/></mxCell>
        <mxCell id="arch03-15" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vault seal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Argon2id master · age payload&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;minisign over binding root&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eaf3ee;strokeColor=#3c7d4f;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-14"><mxGeometry x="150" y="18" width="210" height="74" as="geometry"/></mxCell>
        <mxCell id="arch03-16" value="&lt;b style=&quot;font-size:13px&quot;&gt;.svault container&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;CBOR header + age payload&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;+ signature, on disk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eaf3ee;strokeColor=#3c7d4f;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-14"><mxGeometry x="410" y="18" width="210" height="74" as="geometry"/></mxCell>
        <mxCell id="arch03-17" value="&lt;b style=&quot;font-size:13px&quot;&gt;Unlock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;verify signature → derive key&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;→ unwrap identity&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eaf3ee;strokeColor=#3c7d4f;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-14"><mxGeometry x="670" y="18" width="210" height="74" as="geometry"/></mxCell>
