        <mxCell id="arch03-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch03-46" target="arch03-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch03-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch03-47" target="arch03-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch03-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;" edge="1" parent="1" source="arch03-48" target="arch03-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch03-54" value="&lt;b style=&quot;font-size:13px&quot;&gt;QR transfer  (optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;share strings → QR PNG (EC-H)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;scan elsewhere → decode (rqrr)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="560" y="624" width="210" height="56" as="geometry"/></mxCell>
        <mxCell id="arch03-55" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="arch03-46" target="arch03-54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch03-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#566072;strokeWidth=1.4;jettySize=auto;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="arch03-54" target="arch03-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch03-57" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="320" height="148" as="geometry"/></mxCell>
        <mxCell id="arch03-58" value="" style="rounded=0;html=1;fillColor=#eaf3ee;strokeColor=#3c7d4f;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="737" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch03-59" value="Vault path (sv-core)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="735" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-60" value="" style="rounded=0;html=1;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="756" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch03-61" value="File encryption path (sv-platform)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="754" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-62" value="" style="rounded=0;html=1;fillColor=#e7f1f2;strokeColor=#2f7b86;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="775" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch03-63" value="Steganography path (sv-stego)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="773" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-64" value="" style="rounded=0;html=1;fillColor=#eef0f6;strokeColor=#46506a;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="794" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch03-65" value="Secret-sharing path (sv-platform / sv-core)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="792" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-66" value="" style="rounded=0;html=1;fillColor=#efeaf8;strokeColor=#6a4f9c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="52" y="813" width="18" height="13" as="geometry"/></mxCell>
        <mxCell id="arch03-67" value="QR transfer (sv-qr) — carries shares" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="811" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-68" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#566072;strokeWidth=1.7;dashed=1;dashPattern=5 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="838" as="sourcePoint"/><mxPoint x="70" y="838" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="arch03-69" value="optional / conditional step" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1c2330;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="78" y="830" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-70" value="&lt;b style=&quot;color:#1c2330&quot;&gt;Notes&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#aab2bf;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="706" width="1080" height="129" as="geometry"/></mxCell>
        <mxCell id="arch03-71" value="• Four independent protection paths share the same input and produce the same recovered output; a user picks one (or composes them)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="735" width="1056" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-72" value="• Two distinct encryption mechanisms: the Vault payload uses age; standalone file encryption uses Argon2id + secretbox (SVENC)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="754" width="1056" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-73" value="• Secret sharing splits a key (the vault master key, or a freshly generated DEK that encrypts the payload) — never the raw passphrase." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="773" width="1056" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-74" value="• QR transfer is a transport for share strings only; it sits between 'Shares' and 'Recover' and is optional." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="792" width="1056" height="16" as="geometry"/></mxCell>
        <mxCell id="arch03-75" value="• Every recovery is fail-safe: a wrong key, wrong share set, or tampered carrier yields a coded error, not a partial/incorrect result." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#45505f;fontSize=10.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="392" y="811" width="1056" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
