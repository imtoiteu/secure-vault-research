        <mxCell id="arch03-24" value="File encryption  (sv-platform)" style="swimlane;html=1;horizontal=0;startSize=120;rounded=1;arcSize=3;fillColor=none;swimlaneFillColor=none;strokeColor=#2f6ab0;strokeWidth=1.3;dashed=1;dashPattern=4 4;fontColor=#2f6ab0;fontStyle=1;fontSize=12;verticalAlign=middle;align=center;collapsible=0;" vertex="1" parent="1"><mxGeometry x="150" y="236" width="1180" height="110" as="geometry"/></mxCell>
        <mxCell id="arch03-25" value="&lt;b style=&quot;font-size:13px&quot;&gt;Encrypt file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;Argon2id + secretbox&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;(SVENC artifact)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-24"><mxGeometry x="150" y="18" width="210" height="74" as="geometry"/></mxCell>
        <mxCell id="arch03-26" value="&lt;b style=&quot;font-size:13px&quot;&gt;Encrypted file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;.svenc on disk&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;move / back up freely&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-24"><mxGeometry x="410" y="18" width="210" height="74" as="geometry"/></mxCell>
        <mxCell id="arch03-27" value="&lt;b style=&quot;font-size:13px&quot;&gt;— same file —&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;no separate recovery step&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;ciphertext is portable&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f4f6f9;strokeColor=#5b6675;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-24"><mxGeometry x="670" y="18" width="210" height="74" as="geometry"/></mxCell>
        <mxCell id="arch03-28" value="&lt;b style=&quot;font-size:13px&quot;&gt;Decrypt file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;verify MAC → plaintext&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;pre-auth cost ceilings&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-24"><mxGeometry x="930" y="18" width="210" height="74" as="geometry"/></mxCell>
