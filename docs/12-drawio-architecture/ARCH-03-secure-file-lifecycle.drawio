        <mxCell id="arch03-36" value="&lt;b style=&quot;font-size:13px&quot;&gt;Carrier image&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;PNG / BMP / JPEG&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;(visually unchanged)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e7f1f2;strokeColor=#2f7b86;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch03-34"><mxGeometry x="410" y="18" width="210" height="74" as="geometry"/></mxCell>
