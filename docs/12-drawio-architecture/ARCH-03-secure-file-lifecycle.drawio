        <mxCell id="arch03-34" value="Steganography  (sv-stego)" style="swimlane;html=1;horizontal=0;startSize=120;rounded=1;arcSize=3;fillColor=none;swimlaneFillColor=none;strokeColor=#2f7b86;strokeWidth=1.3;dashed=1;dashPattern=4 4;fontColor=#2f7b86;fontStyle=1;fontSize=12;verticalAlign=middle;align=center;collapsible=0;" vertex="1" parent="1"><mxGeometry x="150" y="362" width="1180" height="110" as="geometry"/></mxCell>
