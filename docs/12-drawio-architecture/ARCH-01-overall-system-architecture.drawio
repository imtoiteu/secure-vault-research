        <mxCell id="arch01-9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Tauri 2 WebView — static frontend (withGlobalTauri)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;index.html · main.js · i18n.js · styles.css&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#45505f&quot;&gt;22 screen sections (20 routable) · vi/en i18n · CSP: no inline scripts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f1fd;strokeColor=#2f6ab0;strokeWidth=1.3;fontColor=#1c2330;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="arch01-8"><mxGeometry x="120" y="12" width="1032" height="56" as="geometry"/></mxCell>
